# JavaScript deps (EAS installs these itself)
node_modules/
functions/
emulator-data
# Local Expo and Metro caches
.expo/
.expo-shared/
# Logs, temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
# IDE settings
.vscode/
# Environment files (store real secrets elsewhere)
.env.local
.env.development.local
.env.*.local
# Native credentials and local Firebase configuration. The Android production
# build receives google-services.json through the GOOGLE_SERVICES_JSON EAS file
# environment variable instead.
secure/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
# Tests and docs
__tests__/
android/
ios/
