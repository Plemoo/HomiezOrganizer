rules_version = '2';
service cloud.firestore {   
  match /databases/{database}/documents {
    // Nutzer ist registriert, wenn es ein passendes Dokument in /users gibt
    function isAuthenticatedUser() {
      return exists(/databases/$(database)/documents/User/$(request.auth.uid));
    }
    match /Group/{groupId} {
    function parentAllowsUser() {
      // Get the parent document
      let parent = /databases/$(database)/documents/Group/$(groupId);
      // It must exist, and its memberUuids must contain the UID
      return exists(parent)
        && request.auth.uid in get(parent).data.memberUuids;
    }         
      // Group creation and membership changes are validated by Cloud Functions.
      allow create: if false;
      allow update: if false;
      // Members may read; only the owner may delete the complete group.
      allow read: if request.auth.uid in resource.data.memberUuids;
      allow delete: if request.auth.uid == resource.data.get('ownerUuid', resource.data.memberUuids[0]);
      match /Invitation/{invitaitonId} {
        // only members can create invites
        allow create: if request.auth.uid in 
          get(/databases/$(database)/documents/Group/$(groupId)).data.memberUuids;
        // Invite redemption is validated by the callable Cloud Function.
        allow read: if false;
        // only your client‐run transaction can increment uses
        allow update: if false;
      }
      match /Activity/{activityId}{
        allow read: if isAuthenticatedUser() && parentAllowsUser();
        allow create, update: if isAuthenticatedUser()
          && parentAllowsUser()
          && request.resource.data.owningGroupId == groupId;
        allow delete: if isAuthenticatedUser() && parentAllowsUser();
        match /Comment/{commentId}{
          allow create, read, delete: if isAuthenticatedUser() && parentAllowsUser();
        }
      }
    }
    // Zugriff auf eigene User-Daten
    match /User/{uid} {
      allow update: if isAuthenticatedUser()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'groupUuids']);
      allow delete: if isAuthenticatedUser() && request.auth.uid == uid;
      allow read: if isAuthenticatedUser()
        && (
          request.auth.uid == uid
          || resource.data.get('groupUuids', []).toSet().intersection(
            get(/databases/$(database)/documents/User/$(request.auth.uid)).data.get('groupUuids', []).toSet()
          ).size() > 0
        );
    }
    // Alle dürfen neue User erstellen
    match /User/{uid} {
      allow create: if request.auth != null
        && request.resource.data.id == request.auth.uid
        && request.resource.data.get('groupUuids', []).size() == 0;
    }
  }
}
