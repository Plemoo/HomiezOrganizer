{
  "name": "homiezorganizer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "startCache": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest --watchAll",
    "pixel8": "expo run:android --device Pixel_8_API_35",
    "pixel9": "expo run:android --device Pixel_9",
    "anyDevice": "expo run:android --device",
    "saveRunningFirebaseEmulatorData": "firebase emulators:export ./emulator-data",
    "firebaseEmulator": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "firebaseEmulatorDebug": "firebase emulators:start --import=./emulator-data --export-on-exit --debug",
    "deploy": "firebase deploy --only firestore:rules,functions"
  },
  "jest": {
    "preset": "jest-expo"
  },
