{
  "name": "aktivitaeten-finder",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "startCache": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "test:rules": "jest __tests__/firestore.rules.test.ts --runInBand",
    "pixel8": "expo run:android --device Pixel_8_API_35",
    "pixel9": "expo run:android --device Pixel_9",
    "anyDevice": "expo run:android --device",
    "saveRunningFirebaseEmulatorData": "firebase emulators:export ./emulator-data",
    "firebaseEmulator": "npm --prefix functions run build && firebase emulators:start --import=./emulator-data --export-on-exit",
    "firebaseEmulatorDebug": "npm --prefix functions run build && firebase emulators:start --import=./emulator-data --export-on-exit --debug",
    "seedEmulator": "node functions/scripts/seed-emulator.js",
    "deployFirestore": "firebase deploy --only firestore:rules,functions",
    "newBuild": "eas build --profile production",
    "deployHosting": "firebase deploy --only hosting"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@quidone/react-native-wheel-picker": "^1.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^22.2.1",
    "@react-native-firebase/auth": "^22.2.1",
    "@react-native-firebase/firestore": "^22.2.1",
    "@react-native-firebase/functions": "^22.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@types/jest": "^29.5.14",
    "dayjs": "^1.11.13",
    "expo": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "fast-is-equal": "^1.2.3",
    "i18next": "^26.3.6",
    "jdenticon": "^3.3.0",
    "jest": "~29.7.0",
    "lodash": "^4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@react-native/jest-preset": "^0.86.2",
    "@types/lodash": "^4.17.17",
    "@types/react": "~19.2.0",
    "cross-fetch": "^4.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "firebase-tools": "^15.24.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3",
    "zod-to-ts": "^2.1.0"
  },
  "private": true
}
