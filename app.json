{
  "expo": {
    "name": "Aktivitäten planen",
    "slug": "HomiesOrganizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "scheme": "aktivitaetenfinder",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "9b75a12e-e96f-4f25-9f29-ca766b90d6d1"
      },
      "router": {}
    },
    "platforms": ["android", "ios"],
    "ios": {
      "icon": "./assets/branding/app-icon.png",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.plemo.homiesOrganizer",
      "googleServicesFile": "./secure/GoogleService-Info.plist"
    },
    "android": {
      "icon": "./assets/branding/app-icon.png",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/android-monochrome.png",
        "backgroundColor": "#0A0A0A"
      },
      "googleServicesFile": "./secure/google-services.json",
      "package": "com.homiesOrganizer"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#B8B8B8",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser",
      "expo-dev-client",
      ["@react-native-firebase/app", {}],
      ["@react-native-firebase/auth", {}]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
